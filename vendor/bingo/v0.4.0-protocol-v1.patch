+        member: String,
+    },
+    #[serde(rename = "channel.post")]
+    ChannelPost {
+        #[serde(rename = "protocolVersion")]
+        protocol_version: u8,
+        #[serde(rename = "commandId")]
+        command_id: String,
+        channel: String,
+        text: String,
+    },
+    #[serde(rename = "channel.history.get")]
+    ChannelHistoryGet {
+        #[serde(rename = "protocolVersion")]
+        protocol_version: u8,
+        #[serde(rename = "commandId")]
+        command_id: String,
+        channel: String,
+    },
+    #[serde(rename = "session.rename")]
+    SessionRename {
+        #[serde(rename = "protocolVersion")]
+        protocol_version: u8,
