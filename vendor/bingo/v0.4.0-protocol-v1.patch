+        #[serde(rename = "protocolVersion")]
+        protocol_version: u8,
+        #[serde(rename = "commandId")]
+        command_id: String,
+        #[serde(rename = "attachmentId")]
+        attachment_id: String,
+        data: String,
+    },
+    #[serde(rename = "turn.start")]
