+        #[serde(rename = "protocolVersion")]
+        protocol_version: u8,
+        #[serde(rename = "commandId")]
+        command_id: String,
+        #[serde(rename = "turnId")]
+        turn_id: String,
+        prompt: String,
+    },
+    #[serde(rename = "turn.cancel")]
