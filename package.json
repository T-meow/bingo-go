{
  "name": "bingo-go",
  "version": "0.1.0",
  "private": true,
  "description": "Independent desktop workbench compatible with bingo",
  "author": "T-meow <T-meow@users.noreply.github.com>",
  "license": "MIT",
  "repository": "github:T-meow/bingo-go",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:bingo": "cargo build --manifest-path ../bingo/Cargo.toml --locked --release",
    "build:bingo:win": "npm run build:bingo",
    "prepare:bingo": "node scripts/prepare-bingo-package.mjs",
    "package:win": "npm run build:bingo && npm run build && npm run prepare:bingo && electron-builder --win nsis --x64 --publish never",
    "package:mac": "npm run build:bingo && npm run build && npm run prepare:bingo && electron-builder --mac dmg zip --x64 --publish never",
    "package:linux": "npm run build:bingo && npm run build && npm run prepare:bingo && electron-builder --linux AppImage deb --x64 --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "6.1.0",
    "@ant-design/x": "2.9.0",
    "antd": "6.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "write-file-atomic": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^3.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^4.1.10"
  }
}
